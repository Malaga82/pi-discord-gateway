# Generated by: piscord setup
# Or edit manually. See: piscord help

# Required
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Pi agent configuration
PI_BIN=pi
PI_MODEL=
PI_THINKING=
# Default working directory for pi. Override per channel with:
#   piscord register <id> <name> --cwd /path/to/project
PI_CWD=./
PI_EXTRA_FLAGS=

# Gateway behavior
TRIGGER_NAME=pi
MAX_CONCURRENCY=3
POLL_INTERVAL_MS=1000
SHUTDOWN_TIMEOUT_MS=15000
# DMs bypass the channel policy: keep false unless you accept that any user
# who can reach the bot gets served.
AUTO_REGISTER_DMS=false
MAX_ATTACHMENT_BYTES=26214400
MAX_TOTAL_ATTACHMENT_BYTES=52428800
# Downloaded attachment files are passed to pi by local path and kept for this long.
MEDIA_RETENTION_HOURS=168

# Channel access
# open = any guild channel auto-registers | open-trigger = auto-register but only
# respond to mentions | allowlist = only explicitly registered channels.
CHANNEL_POLICY=allowlist
EXCLUDED_CHANNELS=
# Bot peers allowed to trigger the bot (comma-separated user IDs)
ALLOW_BOT_PEERS=
BOT_LOOP_MAX=10
BOT_LOOP_WINDOW_MS=300000

# Scheduled tasks
MAX_SCHEDULED_CONCURRENCY=5
ARCHIVE_RETENTION_DAYS=30

# Reliability
# A recovered message is abandoned after this many invocation attempts.
MAX_MESSAGE_ATTEMPTS=3
# off | tools | full (live activity log + streamed answer)
STREAMING=tools
STREAMING_UPDATE_MS=2000
AGENT_TIMEOUT_MS=1800000

# Storage examples
# If left unset, the built-in defaults are under ~/.local/share/piscord-gateway/
SESSIONS_DIR=./sessions
DB_PATH=./gateway.db

# Logging
LOG_LEVEL=info
